{
  "workspace": [
    "./client",
    "./server"
  ],
  "tasks": {
    "dev": "deno task --cwd server dev",
    "serve": "deno task --cwd server serve",
    "build": "deno task --cwd server build",
    "test": "deno test -P",
    "check": "deno task --cwd client check && deno task --cwd server check && deno lint && deno fmt --check"
  },
  "permissions": {
    "default": {
      "read": true,
      "env": true,
      "net": [
        "localhost",
        "127.0.0.1"
      ],
      "import": true
    }
  },
  "test": {
    "permissions": "default"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@kuboon/*",
      "jsr:@remix-kbn/*",
      "npm:@remix-run/*"
    ]
  },
  "unstable": [
    "bundle"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component"
  },
  "imports": {
    "@kuboon/md": "jsr:@kuboon/md@^0.7.0",
    "@kuboon/share-element": "jsr:@kuboon/share-element@^0.5.0",
    "@remix-kbn/assets-deno": "jsr:@remix-kbn/assets-deno@^0.9.0",
    "@remix-kbn/ssg": "jsr:@remix-kbn/ssg@^0.13.0",
    "@remix-run/component": "npm:@remix-run/component@^1.0.0",
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@^1.0.0",
    "@remix-run/render-middleware": "npm:@remix-run/render-middleware@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "canvaskit-wasm": "npm:canvaskit-wasm@^0.40.0"
  },
  "fmt": {
    "exclude": [
      "dist",
      "node_modules"
    ]
  },
  "lint": {
    "exclude": [
      "dist",
      "node_modules"
    ]
  }
}
